# Node service image (build context = repo root). Used by the GraphQL BFF
# (services/bff, TASK-WEB-005). ARG SERVICE selects which service under services/.
ARG SERVICE=bff

FROM node:24-slim AS build
ARG SERVICE
WORKDIR /app
COPY services/${SERVICE}/package.json services/${SERVICE}/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY services/${SERVICE}/ ./
RUN npm run build && npm prune --omit=dev

FROM node:24-slim
ARG SERVICE
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
EXPOSE 8085
CMD ["node", "dist/server.js"]
