# Copy this file to deploy/.env and set real values before deploying.
#   cp deploy/.env.example deploy/.env
# docker compose auto-loads deploy/.env. Never commit deploy/.env (it is gitignored).

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # CHANGE this for any non-local deployment
POSTGRES_DB=shopass

# --- Host ports (change if they clash with something already running) ---
DB_PORT=5432
PRICE_PORT=8081
WEB_PORT=3000
DEAL_PORT=8082    # deal chart feed (TASK-DEAL-003)
TRACK_PORT=8083   # track wishlists
AUTH_PORT=8084    # auth: login/refresh + social login
BFF_PORT=8085     # GraphQL BFF

# --- Auth ---
AUTH_ISS=shopass-auth
AUTH_AUD=shopass-gateway
# Social login (TASK-AUTH-004) activates only when GOOGLE_CLIENT_ID is set.
# Get these from Google Cloud Console; keep the secret out of git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Scraper job ---
SHOPEE_BASE_URL=https://shopee.vn
SCRAPE_SEED=                        # e.g. 100:555:777  (productID:itemID:shopID, comma-separated)
# HTTPS_PROXY=http://user:pass@residential-proxy:port   # residential proxy (TASK-SCRAPE-002)
