# DEVELOPMENT / DEMO ONLY.
# Copy this file to deploy/.env for the local stack:
#   cp deploy/.env.example deploy/.env
# docker compose auto-loads deploy/.env. Never commit deploy/.env (it is gitignored).
#
# Do not use this file or docker-compose.yml for an Internet-facing deployment.
# Use deploy/.env.production.example and docker-compose.production.yml instead.

# --- Database ---
# POSTGRES_PASSWORD is required by docker-compose.yml (no inline default).
# This example value is for loopback-bound local compose only — never reuse on
# a shared or Internet-facing host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=shopass

# --- Host ports (bound to 127.0.0.1 in docker-compose.yml) ---
DB_PORT=5432
PRICE_PORT=8081
WEB_PORT=3000
DEAL_PORT=8082    # deal chart feed (FR-DEAL-003)
TRACK_PORT=8083   # track wishlists
AUTH_PORT=8084    # auth: login/refresh + social login
BFF_PORT=8085     # GraphQL BFF

# --- Auth ---
AUTH_ISS=shopass-auth
AUTH_AUD=shopass-gateway
# Local-only social login requires this explicit flag and a client id. It is
# intentionally blocked in production until the BFF owns its callback.
ENABLE_GOOGLE_OAUTH=false
# Get these from Google Cloud Console; keep the secret out of git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Shared local-only credential for tracksvc -> pricesvc. This is intentionally
# not a production secret; production reads PRICE_INTERNAL_SERVICE_TOKEN from
# the root-owned runtime environment instead.
PRICE_INTERNAL_SERVICE_TOKEN=dev-only-change-me

# --- Scraper job ---
SHOPEE_BASE_URL=https://shopee.vn
SCRAPE_SEED=                        # e.g. 100:555:777  (productID:itemID:shopID, comma-separated)
# HTTPS_PROXY=http://user:pass@residential-proxy:port   # residential proxy (FR-SCRAPE-002)
