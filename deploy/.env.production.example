# PRODUCTION RUNTIME TEMPLATE — copy to a root-owned file, never commit secrets.
#
#   sudo install -d -m 0700 /etc/shopass /etc/shopass/secrets
#   sudo install -m 0600 deploy/.env.production.example /etc/shopass/runtime.env
#   sudoedit /etc/shopass/runtime.env
#
# Then:
#   sudo docker compose --env-file /etc/shopass/runtime.env \
#     -f deploy/docker-compose.production.yml config
#
# Do not use deploy/.env.example or docker-compose.yml on an Internet-facing host.
# Google OAuth is hardcoded false in docker-compose.production.yml; do not enable it.
# Never set ALLOW_SEED or APP_ENV=dev on production.

# --- Public edge (Caddy) ---
# API is same-origin /v1 on this host. Do not point clients at api.* until that
# name exists and is an intentional extra Caddy site.
APP_DOMAIN=shopass.example.com
ACME_EMAIL=ops@example.com
APP_ORIGIN=https://shopass.example.com
HTTP_PORT=80
HTTPS_PORT=443
# CADDYFILE=./Caddyfile
# CADDY_IMAGE=caddy:2.8.4-alpine

# Next.js auth handlers call the private gateway. Never a public URL.
GATEWAY_INTERNAL_BASE_URL=http://gateway:8080

# --- Database ---
POSTGRES_USER=shopass
POSTGRES_DB=shopass
# Root-owned file, mode 0400. See deploy/secrets/README.md.
DB_PASSWORD_FILE=/etc/shopass/secrets/db_password
# Temporary: binaries still read DATABASE_URL from env (INFRA-003 incomplete).
DATABASE_URL=postgres://shopass:CHANGE-ME@db:5432/shopass?sslmode=disable

# --- Auth ---
AUTH_ISS=shopass-auth
AUTH_AUD=shopass-gateway
AUTH_KEY_ID=CHANGE-ME-key-id
AUTH_SIGNING_KEY_SECRET_FILE=/etc/shopass/secrets/auth_signing_key.pem
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Private service tokens (identical values on both sides of each hop) ---
# tracksvc <-> pricesvc (X-Service-Token). Also authenticates
# pricesvc → tracksvc POST /internal/v1/price-changed.
PRICE_INTERNAL_SERVICE_TOKEN=CHANGE-ME-high-entropy
PRICE_INTERNAL_URL=http://pricesvc:8081
TRACK_INTERNAL_URL=http://tracksvc:8083
# tracksvc -> billsvc gating
BILL_INTERNAL_SERVICE_TOKEN=CHANGE-ME-high-entropy
BILL_INTERNAL_URL=http://billsvc:8086
# complysvc breach open/advance/close (X-Operator-Token). Fail-closed if empty.
# Not allowlisted on the public gateway; use the private network.
COMPLY_OPERATOR_TOKEN=CHANGE-ME-high-entropy

# --- Notifications (leave empty to enqueue-only; FCM dispatcher stays idle) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Billing sandboxes (without secrets CreatePayment stays stub URL) ---
MOMO_PARTNER_CODE=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_MAC_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- Scraper (jobs profile / systemd timers) ---
SHOPEE_BASE_URL=https://shopee.vn
SCRAPE_SEED=
# HTTPS_PROXY=http://user:pass@residential-proxy:port
# HTTP_PROXY=
# NO_PROXY=pricesvc,db,localhost,127.0.0.1

# --- Optional image pins ---
# TIMESCALE_IMAGE=timescale/timescaledb:2.28.2-pg16
# REDIS_IMAGE=redis:7.4.2-alpine
# POSTGRES_TOOL_IMAGE=postgres:16.4-alpine
