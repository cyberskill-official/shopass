# Add this site block to the CyberOS Caddyfile only after the Shopass edge
# network and containers are healthy. The backend aliases are scoped to the
# dedicated `shopass-edge` Docker network; no Shopass database or cache is
# reachable from CyberOS or the Internet.
#
# API is same-origin /v1 on this host. Do not add an api.* site unless DNS
# for that name exists and is an intentional extra origin.
shopass.cyberskill.world {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	request_body {
		max_size 1MB
	}

	@direct_auth path /v1/auth/*
	handle @direct_auth {
		respond "not found" 404
	}

	@api path /v1/* /graphql /graphql/*
	handle @api {
		reverse_proxy shopass-gateway:8080 {
			health_uri /healthz
			health_interval 5s
			health_timeout 2s
			health_status 200
			header_up -X-User-Id
			header_up -X-User-Locale
			header_up -X-User-Tier
			header_up X-Real-IP {remote_host}
			header_up -X-Service-Token
			header_up -X-Operator-Token
		}
	}

	handle {
		reverse_proxy shopass-web:3000 {
			health_uri /api/healthz
			health_interval 5s
			health_timeout 2s
			health_status 200
			header_up -X-User-Id
			header_up -X-User-Locale
			header_up -X-User-Tier
			header_up X-Real-IP {remote_host}
			header_up -X-Service-Token
			header_up -X-Operator-Token
		}
	}
}
