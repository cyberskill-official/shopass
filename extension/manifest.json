{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "vi",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "homepage_url": "https://shopass.cyberskill.world",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "offscreen", "declarativeNetRequest"],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://*.tiktok.com/*",
    "https://www.lazada.vn/*",
    "https://api.shopass.cyberskill.world/*",
    "http://127.0.0.1:8080/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shopass_api_allowlist",
        "enabled": true,
        "path": "dnr/rules.json"
      }
    ]
  },
  "options_page": "ui/settings.html",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["content/shopee/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["content/tiktok/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.lazada.vn/*"],
      "js": ["content/lazada/index.js"],
      "run_at": "document_idle"
    }
  ]
}
