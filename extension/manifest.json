{
  "manifest_version": 3,
  "name": "Shopass",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/shopass/sandeal-extension",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://*.tiktok.com/*",
    "https://www.lazada.vn/*"
  ],
  "options_page": "ui/settings.html",
  "action": { "default_title": "Shopass" },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["content/shopee/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["content/tiktok/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.lazada.vn/*"],
      "js": ["content/lazada/index.js"],
      "run_at": "document_idle"
    }
  ]
}
