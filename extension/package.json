{
  "name": "extension",
  "version": "1.0.0",
  "description": "Shopass MV3 browser extension",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "SHOPASS_ENV=production node build.mjs",
    "build:dev": "SHOPASS_ENV=development node build.mjs",
    "build:staging": "SHOPASS_ENV=staging node build.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/chrome": "^0.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
