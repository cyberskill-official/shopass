## §3 - Hợp đồng API / DDL

### hash.ts (one-way + salt server, không gửi thô)

```ts
// extension/src/fingerprint/hash.ts
// collect() trả tập thuộc tính ổn định-vừa-phải (KHÔNG gửi thô đi đâu).
// hashDevice gửi server CHỈ chuỗi hash; server thêm salt rồi lưu.
import { collect } from "./collect";

export async function deviceHash(serverSalt: string): Promise<string> {
  const attrs = collect();                       // {tz, lang, platform coarse, screenBucket...}
  const stable = JSON.stringify(attrs);          // KHÔNG bao giờ rời máy nguyên dạng
  const data = new TextEncoder().encode(serverSalt + "|" + stable);
  const digest = await crypto.subtle.digest("SHA-256", data);
  return [...new Uint8Array(digest)].map(b => b.toString(16).padStart(2, "0")).join("");
}
// Gửi server: { device_hash } DUY NHẤT. Không attrs thô.
```

### Migration

```sql
-- services/trust/migrations/0004_device_fingerprint.sql
CREATE TABLE device_fingerprint (
  device_hash TEXT        NOT NULL,              -- one-way hash (salt server), KHÔNG thuộc tính thô
  user_id     BIGINT      NOT NULL REFERENCES app_user(id),
  first_seen  TIMESTAMPTZ NOT NULL DEFAULT now(),
  last_seen   TIMESTAMPTZ NOT NULL DEFAULT now(),
  PRIMARY KEY (device_hash, user_id)             -- idempotent: cập nhật last_seen
);
CREATE INDEX idx_fp_hash ON device_fingerprint (device_hash);
-- Mục đích DUY NHẤT: chống gian lận (PDPL). KHÔNG PII, KHÔNG theo dõi/quảng cáo.
```

### device.go (hash chung nhiều user -> cạnh device)

```go
// services/trust/internal/fraud/device.go
// Record lưu fingerprint; nếu device_hash đã gắn user khác -> ghi cạnh 'device'.
func (d *Device) Record(ctx context.Context, hash string, userID int64) error {
    if err := d.upsert(ctx, hash, userID); err != nil { return err }
    others, _ := d.usersForHash(ctx, hash, userID) // user khác cùng hash
    for _, other := range others {
        if err := d.graph.AddEdge(ctx, userID, other, "device", 1.0); err != nil { // FR-TRUST-004
            return err
        }
    }
    if len(others)+1 >= d.cfg.SharedAccountThreshold {
        metrics.DeviceSharedAccounts(len(others) + 1)   // TÍN HIỆU, không auto-khóa
    }
    return nil
}
```

