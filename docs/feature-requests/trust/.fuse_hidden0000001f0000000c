## §5 - Kiểm thử (verification)

```ts
// extension/test/fingerprint-no-pii.test.ts
import { deviceHash } from "../src/fingerprint/hash";

test("chỉ gửi hash, KHÔNG thuộc tính thô/PII", async () => {
  const h = await deviceHash("server-salt-xyz");
  expect(h).toMatch(/^[0-9a-f]{64}$/);          // SHA-256 hex
  // payload gửi server (giả lập) chỉ có device_hash
  const payload = { device_hash: h };
  const flat = JSON.stringify(payload).toLowerCase();
  expect(flat).not.toMatch(/mozilla|font|canvas|webgl|user-agent/); // không thuộc tính thô
  expect(Object.keys(payload)).toEqual(["device_hash"]);
});

test("hash ổn định trên cùng thiết bị, khác salt -> khác hash (xoay được)", async () => {
  const a = await deviceHash("salt-1");
  const b = await deviceHash("salt-2");
  expect(a).not.toEqual(b);                      // salt xoay đổi hash
});
```

