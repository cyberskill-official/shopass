## §3 - Hợp đồng API / DDL

### Migrations

```sql
-- services/trust/migrations/0001_fraud_signal.sql
CREATE TABLE fraud_signal (
  id              BIGSERIAL PRIMARY KEY,
  subject_user_id BIGINT      NOT NULL REFERENCES app_user(id),
  kind            TEXT        NOT NULL,        -- 'velocity' | 'graph' | 'rule'
  risk_score      SMALLINT    NOT NULL CHECK (risk_score BETWEEN 0 AND 100),
  reasons         JSONB       NOT NULL,        -- [{signal, detail, contribution}] - giải thích
  status          TEXT        NOT NULL DEFAULT 'open'
                  CHECK (status IN ('open','investigating','confirmed_fraud','cleared')),
  created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE (subject_user_id, kind)               -- idempotent: cập nhật, không nhân bản
);
CREATE INDEX idx_fraud_open ON fraud_signal (status, risk_score DESC) WHERE status = 'open';

-- services/trust/migrations/0002_account_link_edge.sql
CREATE TABLE account_link_edge (
  a_user    BIGINT NOT NULL REFERENCES app_user(id),
  b_user    BIGINT NOT NULL REFERENCES app_user(id),
  link_type TEXT   NOT NULL,                   -- 'referral' | 'payment' | 'device'(FR-TRUST-006)
  weight    REAL   NOT NULL DEFAULT 1.0,
  PRIMARY KEY (a_user, b_user, link_type),
  CHECK (a_user < b_user)                      -- cạnh vô hướng chuẩn hóa (tránh trùng đảo chiều)
);
CREATE INDEX idx_edge_b ON account_link_edge (b_user, link_type);
```

### score.go (tổ hợp tín hiệu -> risk_score + reasons)

```go
// services/trust/internal/fraud/score.go
type Reason struct {
    Signal       string `json:"signal"`
    Detail       string `json:"detail"`
    Contribution int    `json:"contribution"` // điểm cộng vào risk_score
}

type Assessment struct {
    UserID    int64
    RiskScore int       // 0-100
    Reasons   []Reason
}

// Assess tổ hợp ba lớp; KHÔNG khóa, chỉ chấm điểm + giải thích.
func (e *Engine) Assess(ctx context.Context, userID int64) (Assessment, error) {
    var reasons []Reason
    score := 0
    if v := e.velocity(ctx, userID); v.Triggered { score += v.Weight; reasons = append(reasons, v.Reason) }
    if g := e.graphCluster(ctx, userID); g.Triggered { score += g.Weight; reasons = append(reasons, g.Reason) }
    if r := e.rules(ctx, userID); r.Triggered { score += r.Weight; reasons = append(reasons, r.Reason) }
    if score > 100 { score = 100 }

    a := Assessment{UserID: userID, RiskScore: score, Reasons: reasons}
    if score >= e.cfg.HoldThreshold {
        e.holdRewards(ctx, userID)   // HOLD (FR-TRUST-005), KHÔNG tịch thu
    }
    return a, e.upsertSignal(ctx, a) // idempotent upsert
}
```

### graph.go (cụm tài khoản liên kết)

```go
// services/trust/internal/fraud/graph.go
// clusterSize đếm tài khoản trong cùng cụm liên kết (BFS qua account_link_edge).
const clusterSQL = `
WITH RECURSIVE reach(uid) AS (
  SELECT $1
  UNION
  SELECT CASE WHEN e.a_user = r.uid THEN e.b_user ELSE e.a_user END
  FROM account_link_edge e JOIN reach r ON r.uid IN (e.a_user, e.b_user)
)
SELECT count(*) FROM reach;`
```

